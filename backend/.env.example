# API — ตัวอย่างค่า config (ห้ามใส่รหัสผ่านจริงในไฟล์นี้)
PORT=8899
FRONTEND_URL=http://localhost:5173

# Supabase Postgres — เอา URL จริงจาก Supabase Dashboard (มีรหัสผ่าน) ใส่ใน .env
# แนะนำ: DATABASE_URL = pooler (6543) สำหรับรันแอป, DIRECT_URL = direct (5432) สำหรับ migrate
DATABASE_URL=postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:6543/postgres
DIRECT_URL=postgresql://postgres.[REF]:[YOUR-PASSWORD]@aws-0-ap-southeast-1.pooler.supabase.com:5432/postgres

JWT_SECRET=change-me-to-long-random-string
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

NODE_ENV=development
# Set only to the verified number of trusted reverse proxies in production.
TRUST_PROXY_HOPS=0
AI_USER_DAILY_LIMIT=10
AI_GLOBAL_DAILY_LIMIT=100
# Before starting the updated API: npm run migrate:security && npx prisma generate
# Production DATABASE_URL must use a limited runtime role; DIRECT_URL uses the migration role.

# Phase 0: default local mode. Production must set APP_ENV=staging or production.
APP_ENV=development
APP_RELEASE=
# Require an explicitly configured model; verify model availability in your account.
# Optional second model: fallback only on 404/503, each attempt consumes quota.
GEMINI_FALLBACK_MODEL=
AI_ENABLED=true
# Use custom subdomains on the same site with lax when possible.
# For cross-site HTTPS: none (third-party cookie blocking may still require login).
REFRESH_COOKIE_SAME_SITE=lax
# Optional Sentry-compatible DSN; empty means no external reports.
SENTRY_DSN=
# Optional Google Identity Services client ID (must match the frontend client ID).
GOOGLE_CLIENT_ID=
# Optional SMTP settings; set all values to enable password-reset email.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Apply npm run migrate:phase0 before deploying the refresh-token code.
