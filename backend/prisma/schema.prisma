// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

model User {
  id        Int      @id @default(autoincrement()) @map("user_id")
  tokenVersion Int @default(0) @map("token_version")
  username  String   @db.VarChar(50)
  email     String   @unique @db.VarChar(100)
  password  String   @db.VarChar(255)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  // Relations
  trips Trip[]
  aiMessages AiMessage[]

  @@map("users")
}

model Trip {
  id              Int       @id @default(autoincrement()) @map("trip_id")
  userId          Int       @map("user_id")
  tripName        String    @map("trip_name") @db.VarChar(100)
  destination     String?   @db.VarChar(100)
  startDate       DateTime? @map("start_date") @db.Date
  endDate         DateTime? @map("end_date") @db.Date
  tripDescription String?   @map("trip_description") @db.Text
  shareToken      String?   @unique @map("share_token") @db.VarChar(64)
  createdAt       DateTime  @default(now()) @map("created_at")
  updatedAt       DateTime  @updatedAt @map("updated_at")

  // Relations
  days Day[]
  aiMessages AiMessage[]
  user User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("trips")
}

model Day {
  id          Int       @id @default(autoincrement()) @map("day_id")
  tripId      Int       @map("trip_id")
  // แก้ให้มันเพิ่มขึ้นได้ด้วย
  dayCount    Int       @map("day_count")
  dayDate     DateTime? @map("day_date") @db.Date
  description String?   @db.Text
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")

  // Relations
  activities Activity[]
  trip       Trip       @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@map("days")
}


enum ActivityType {
  ACCOMMODATION
  TRANSPORT
  RESTAURANT
  ATTRACTION
}
model Activity {
  id           Int           @id @default(autoincrement()) @map("activity_id")
  dayId        Int           @map("day_id")
  // 2. เปลี่ยนชนิดข้อมูลจาก String? เป็น ActivityType?
  activityType ActivityType? @map("activity_type")
  locationName String        @map("location_name") @db.VarChar(150)
  activityDate DateTime?     @map("activity_date") @db.Date
  activityTime DateTime?     @map("activity_time") @db.Time
  price        Decimal?      @default(0.00) @db.Decimal(10, 2)
  description  String?       @db.Text
  status       String?       @default("planned") @db.VarChar(50)
  // พิกัดแผนที่ (optional — ถ้ามีจะปักหมุดทันที ไม่ต้อง geocode)
  latitude     Float?
  longitude    Float?
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")

  day Day @relation(fields: [dayId], references: [id], onDelete: Cascade)

  @@map("activities")
}

enum AiMessageKind {
  WEATHER
  PLAN
  CHAT
}

// ประวัติข้อความตอบกลับจาก AI (เช่น พยากรณ์อากาศรายทริป)
model AiMessage {
  id        Int            @id @default(autoincrement()) @map("message_id")
  userId    Int            @map("user_id")
  tripId    Int?           @map("trip_id")
  kind      AiMessageKind  @default(WEATHER)
  model     String?        @db.VarChar(100)
  prompt    String?        @db.Text
  content   String         @db.Text
  createdAt DateTime       @default(now()) @map("created_at")

  // Relations
  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  trip Trip? @relation(fields: [tripId], references: [id], onDelete: Cascade)

  @@index([userId, tripId, kind])
  @@index([createdAt], map: "ai_messages_created_at_idx")
  @@map("ai_messages")
}

// Durable counters survive restarts and cannot be reset by deleting AI history.
model AiUsage {
  key String @id
  count Int @default(0)
  updatedAt DateTime @updatedAt @map("updated_at")
  @@map("ai_usage")
}
